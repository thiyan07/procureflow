# ProcureFlow Backend Environment Template
# Copy to .env and fill values. NEVER commit .env

# Database - PostgreSQL primary
DATABASE_URL=postgresql+psycopg://procureflow:procureflow@localhost:5432/procureflow

# JWT
JWT_SECRET=change-me-to-a-strong-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OTP
OTP_PROVIDER=mock
OTP_FIXED_CODE=123456
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# Firebase Cloud Messaging - service account via env (do NOT commit json)
FCM_PROJECT_ID=procureflow-dev
FCM_CLIENT_EMAIL=firebase-adminsdk-xxxxx@procureflow-dev.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...replace...\n-----END PRIVATE KEY-----\n"
# Alternative: set GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccount.json

# App
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Scheduling
SCHEDULER_SAFETY_BUFFER=2
DEFAULT_ACTIVE_COUNTERS=3
DEFAULT_AVG_PROCESSING_MINUTES=3

# Seed
SEED_DEMO_FARMER_MOBILE=9876543210
SEED_DEMO_OPERATOR_MOBILE=9876543211

# Brevo Email OTP (primary for production)
# Get from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=ProcureFlow
EMAIL_PROVIDER=brevo
# Keep mock for dev: OTP_PROVIDER=mock, EMAIL_PROVIDER=mock
# For prod: OTP_PROVIDER=brevo, EMAIL_PROVIDER=brevo
